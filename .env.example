# Server-only settings. Never use NEXT_PUBLIC_ or VITE_ for credentials.
APP_BASE_URL=http://localhost:3000
# Generate a long random value. Legacy BETTER_AUTH_SECRET is accepted during migration.
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required when running Python directly; Docker Compose supplies its own database URL.
DATABASE_URL=postgresql+asyncpg://drawn:replace-me@localhost:5432/drawn

ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
ALIEXPRESS_API_PROTOCOL=IOP
# Only used by legacy TOP protocol.
ALIEXPRESS_TOP_REGION=CN
ALIEXPRESS_DS_ENABLED=false
ALIEXPRESS_ACCESS_TOKEN=

OPENAI_API_KEY=
AGENT_OPENAI_MODEL=gpt-5-mini
PARTS_OPENAI_MODEL=gpt-5-mini

# Standalone frontend proxy; nginx routes /api directly in Docker.
API_INTERNAL_URL=http://127.0.0.1:8000
