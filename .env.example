# Server-only credentials. Never prefix these with NEXT_PUBLIC_ or VITE_.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
# Optional affiliate tracking ID.
ALIEXPRESS_TRACKING_ID=
# Optional authorized DS session token; enables SKU option/price validation.
ALIEXPRESS_ACCESS_TOKEN=
# TOP gateway: CN (eco.taobao.com) or US (api.taobao.com). Default CN.
ALIEXPRESS_TOP_REGION=CN

# Optional: without this key, deterministic model/spec matching remains available.
OPENAI_API_KEY=
PARTS_OPENAI_MODEL=gpt-5-mini
