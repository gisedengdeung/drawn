# Server-only settings. Never use NEXT_PUBLIC_ or VITE_ for credentials.
# Local development: set to the exact local origin. Production: existing Sites origin.
APP_BASE_URL=http://localhost:5173
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
ALIEXPRESS_TOP_REGION=CN
# Affiliate-only by default. DS requires explicit enablement and separate permission.
ALIEXPRESS_DS_ENABLED=false
ALIEXPRESS_ACCESS_TOKEN=

OPENAI_API_KEY=
AGENT_OPENAI_MODEL=gpt-5-mini
PARTS_OPENAI_MODEL=gpt-5-mini
