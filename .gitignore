/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment
.env*
!.env.example

# deployment and generated files
.vercel
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
*.tsbuildinfo

# local AircraftVerse source data (generated web assets stay tracked)
/AircraftVerse_*/
/data/
/**/__MACOSX/
/**/pointCloud.npy
/**/trims.npy
/**/Geom.stp
/**/cadfile.stl
/corpus_dic

# Python backend caches and local environments
/backend/.venv/
**/__pycache__/
.pytest_cache/
*.pyc

# Local ML environment only; model sources, archives and bundles remain trackable.
/ml/.venv

# 로컬 확인용 STL. 배포하지 않습니다 (scripts/prepare-local-stl.mjs 가 만듭니다).
/public/models/local/

# Local ML scratch from the point cloud / parameter model work.
# Scoped to these directories on purpose: develop tracks model artifacts under
# ml/sources, ml/archive and backend/model_bundle, so a global *.pt or *.npz
# rule would block them.
/ml/.venv/
/ml/data/
/ml/runs/
/ml/checkpoints/
/ml/trim-validity-v2/**/*.npz
/ml/trim-validity-v2/**/*.pt
/ml/trim-validity-v2/**/*.onnx

# Parameter fallback boosters (57 MB). Shipped via the team drive like
# model_bundle's source checkpoints, not committed.
/backend/models/trim_param/

# Local SQLite for running the API without Postgres. Schema comes from
# backend/app/database.py; the real deployment uses the compose Postgres.
/backend/local-dev.db
