  "known_issues": [
    {
      "id": "drag_is_mostly_speed",
      "severity": "reporting",
      "detail": "drag test R2 is 0.9516, but predicting the per-speed mean already scores 0.9260. The shape contributes only +0.026. Do not present 0.95 as a shape-prediction result."
    },
    {
      "id": "validity_head_too_weak_for_ui",
      "severity": "blocker",
      "detail": "Exact interval match is 4.3% and 41% of designs get an upper bound above the true one. Threshold tuning cannot fix this: the best F1 any threshold can reach is 0.6771 against 0.6746 today. Retraining is required."
    },
    {
      "id": "upper_decile_shrinkage",
      "severity": "blocker_for_ranking",
      "detail": "Top-decile predictions fall short by 76% of the IQR for flightTime, 65% for current and 49% for power. Predicted maxima reach only 69-83% of the true maxima. Do not rank or search designs with these outputs, the same limit that applies to Max_Distance in POINTNET_MODEL.md section 6."
    },
    {
      "id": "degenerate_hover_rows_in_the_dataset",
      "severity": "data_quality",
      "detail": "Some 0 m/s trim rows pass the row-level validity rule but are not physical: drag is null, maxUc sits at exactly 0.5, the motor power ratio is near zero and thrust falls far below weight. Design 20015 reports 19.27 N for a 72.24 N aircraft and design 3803 reports 64.92 N for 91.95 N. Rare in test (1 of 689 hover rows) but they are in the training data, and they make the model look like it violates physics when it does not. Judge hover behaviour only against clean rows."
    },
    {
      "id": "hover_thrust_anchoring_does_not_work",
      "severity": "closed_negative_result",
      "detail": "Scaling the thrust curve so thrust at 0 m/s equals the predicted Mass times 9.8 raises thrust MAE from 3.22 N to 6.52 N. With the true Mass it would fall to 1.25 N, so the idea is sound but the Mass estimate is too noisy to carry it. Recorded so it is not retried: ml/check_hover_anchor.py."
    },
    {
      "id": "training_code_not_in_repo",
      "severity": "process",
      "detail": "prepare_trims.py, dataset_trim.py, model_trim.py, train_trim.py, evaluate_trim.py and export_onnx_trim.py are not in ml/. Only the run artefacts were handed over, so the result cannot be reproduced or improved from this repo."
    }
  ],
  "scoring_rule": "R2 in the raw target unit over valid trim rows only, referenced to the mean of the scored rows. Rows that are all zero are failed analyses, not physical zeros, and are excluded by actual_mask.",
  "note": "Scored from ml/runs/trim_pointnet_v1_evaluation/test_predictions.npz, which the training run produced with test_used=false. The ONNX pair was checked against these PyTorch predictions to a maximum relative difference of 9.2e-04, the residual coming from where the point cloud is normalised."
